PK!�΀�simulink/stateflow/chart_16.xml<?xml version="1.0" encoding="utf-8"?>
<chart id="16">
  <P Name="name">ODE45 not used</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">16</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">6</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">16</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dXdt = fcn(X, Vr)
    % Parameters
    Vin = 18;  L = 150e-6;  C = 100e-6;  R = 10;
    w = 2*pi*40e3;  Vm = 1;
    Kp1 = 0.002;  Ki1 = 20;
    Kp2 = 0.01;   Ki2 = 50;
    % Unpack states
    iL0 = X(1);  vo0 = X(2);
    iLR = X(3);  iLI = X(4);
    voR = X(5);  voI = X(6);
    ev_i = X(7); ei_i = X(8);
    % Controller
    ev = Vr - vo0;
    iL_ref = Kp1*ev + Ki1*ev_i;
    ei = iL_ref - iL0;
    vcon0 = Kp2*ei + Ki2*ei_i;
    % Duty cycle with saturation
    d = vcon0/Vm;
    d = max(0, min(1, d));
    % Fourier coefficients
    a = sin(2*pi*d)/(2*pi);
    b = (cos(2*pi*d)-1)/(2*pi);
    % Complement (1-s) components
    q0 = 1 - d;
    qR = -a;
    qI = -b;
    % Products using Fourier convolution
    % &lt;s*Vin&gt; : s0*Vin = d*Vin, sR*Vin = a*Vin, sI*Vin = b*Vin
    % &lt;q*vo&gt; and &lt;q*iL&gt; same as Boost
    qvo_0 = q0*vo0 + 2*(qR*voR + qI*voI);
    qvo_R = q0*voR + qR*vo0;
    qvo_I = q0*voI + qI*vo0;
    qiL_0 = q0*iL0 + 2*(qR*iLR + qI*iLI);
    qiL_R = q0*iLR + qR*iL0;
    qiL_I = q0*iLI + qI*iL0;
    % Plant dynamics
    % Buck-Boost: diL/dt = (1/L)*s*Vin - (1/L)*(1-s)*vo
    %             dvo/dt = (1/C)*(1-s)*iL - (1/(RC))*vo
    diL0 = (Vin/L)*d - (1/L)*qvo_0;
    dvo0 = (1/C)*qiL_0 - (1/(R*C))*vo0;
    diLR = (Vin/L)*a - (1/L)*qvo_R + w*iLI;
    diLI = (Vin/L)*b - (1/L)*qvo_I - w*iLR;
    dvoR = (1/C)*qiL_R - (1/(R*C))*voR + w*voI;
    dvoI = (1/C)*qiL_I - (1/(R*C))*voI - w*voR;
    % Controller integrators
    dev_i = ev;
    dei_i = ei;
    dXdt = [diL0; dvo0; diLR; diLI; dvoR; dvoI; dev_i; dei_i];
end</P>
      </eml>
    </state>
    <data SSID="4" name="X">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="dXdt">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="Vr">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
