PK!��A%%simulink/stateflow/chart_16.xml<?xml version="1.0" encoding="utf-8"?>
<chart id="16">
  <P Name="name">ODE45 Old not used</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">16</P>
  <P Name="ssIdHighWaterMark">6</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">2</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">16</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dXdt = fcn(X, Vr)
    % Parameters 
    Vin = 100;  L = 0.5e-3;  C = 150e-6;  R = 10;
    w = 2*pi*40e3;  Vm = 1;
    Kp1 = 0.005;  Ki1 = 10;
    Kp2 = 0.01;   Ki2 = 10;

    % Unpack states
    iL0 = X(1);  vo0 = X(2);
    iLR = X(3);  iLI = X(4);
    voR = X(5);  voI = X(6);
    ev_i = X(7); ei_i = X(8);

    % Controller
    ev = Vr - vo0;
    iL_ref = Kp1*ev + Ki1*ev_i;
    ei = iL_ref - iL0;
    vcon0 = Kp2*ei + Ki2*ei_i;

    % Duty cycle with saturation
    d = vcon0/Vm;
    d = max(0, min(1, d));

    % Fourier coefficients
    a = sin(2*pi*d)/(2*pi);
    b = (sin(pi*d)^2)/pi;

    % Plant dynamics
    diL0 = (Vin/L)*d - (1/L)*vo0;
    dvo0 = (1/C)*iL0 - (1/(R*C))*vo0;
    diLR = (Vin/L)*a - (1/L)*voR + w*iLI;
    diLI = -(Vin/L)*b - (1/L)*voI - w*iLR;
    dvoR = (1/C)*iLR - (1/(R*C))*voR + w*voI;
    dvoI = (1/C)*iLI - (1/(R*C))*voI - w*voR;

    % Controller 
    dev_i = ev;
    dei_i = ei;

    dXdt = [diL0; dvo0; diLR; diLI; dvoR; dvoI; dev_i; dei_i];
end</P>
      </eml>
    </state>
    <data SSID="4" name="X">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="dXdt">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="Vr">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">16</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">16</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
